# THE NINTH DROP — Offline store backend
# Copy to .env and fill in. Never commit .env.

PORT=4001

# POS data (staff, bills, customers, returns...) lives in the database named here.
# Must be a replica set (Atlas is) — sales use transactions.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/offlinestore

# The online store's database on the SAME cluster. Products and categories are read
# from here, and shop sales update its stock. Leave empty if both share one database.
ONLINE_DB_NAME=thenine

# Website databases whose catalog the POS must never edit (comma-separated).
# "thenine" is always protected. Catalog editing only works on the store's own database.
LIVE_DB_NAME=

# Long random string (32+ chars), DIFFERENT from the online backend's JWT secrets.
POS_JWT_SECRET=change_me_to_a_long_random_string
POS_SESSION_HOURS=12
POS_COOKIE_DOMAIN=

# Public URL of the POS frontend (used in bill QR codes and WhatsApp bill links).
POS_PUBLIC_URL=http://localhost:3001

# Only if the frontend calls this server directly (not through its /api proxy).
# Comma-separated origins.
CLIENT_ORIGIN=

# Cloudinary (same account as the online store) — store logo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=the-nine/pos

# First super admin, used only by `npm run seed:admin`.
POS_ADMIN_EMAIL=owner@example.com
POS_ADMIN_PASSWORD=change_me_now
POS_ADMIN_NAME=Owner
